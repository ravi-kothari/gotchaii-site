---
// Self-hosted fonts: no external request on the critical path, which matters
// because visitors load this on market cell data.
import '@fontsource/rozha-one/400.css';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  /** Opt out of the LocalBusiness block on pages where it does not belong. */
  structuredData?: boolean;
}

const { title, description, structuredData = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Astro rewrites asset imports for `base`, but NOT hand-written hrefs. Any
// root-relative link must be prefixed or it 404s on a project sub-path.
const base = import.meta.env.BASE_URL;
const path = (p: string) => `${base.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F5E9D9" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(path('og-image.jpg'), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Got Chaii" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={path('favicon.svg')} type="image/svg+xml" />

    {
      /*
        LocalBusiness markup. The business sells from a market stall, so hours
        and location are the facts worth surfacing — someone searching for chaii
        in Sacramento can see when we are there without opening the page.
      */
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'FoodEstablishment',
            name: 'Got Chaii',
            description:
              'Whole-spice Indian chaii blends and café pours, sold at Meadowview Farmers Market in Sacramento.',
            servesCuisine: 'Indian',
            url: Astro.site?.href,
            sameAs: [
              'https://instagram.com/gotchaii',
              'https://tiktok.com/@gotchaii',
            ],
            image: new URL(path('og-image.jpg'), Astro.site).href,
            address: {
              '@type': 'PostalAddress',
              streetAddress: '3501 Meadowview Rd',
              addressLocality: 'Sacramento',
              addressRegion: 'CA',
              addressCountry: 'US',
            },
            openingHoursSpecification: [
              {
                '@type': 'OpeningHoursSpecification',
                dayOfWeek: 'https://schema.org/Sunday',
                opens: '09:00',
                closes: '13:00',
              },
            ],
          })}
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: var(--space-s);
        background: var(--ink);
        color: var(--cream);
        padding: var(--space-xs) var(--space-s);
        border-radius: var(--radius-s);
        z-index: 100;
      }
      .skip:focus {
        left: var(--space-s);
      }
    </style>
  </body>
</html>
