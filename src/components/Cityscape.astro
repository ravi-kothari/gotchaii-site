---
/*
  The packaging's defining device: a line-drawn Indian skyline anchoring the
  lower third of every box. Reused here as a horizon band so the site is
  grounded the same way the product is.

  Drawn rather than traced — the product photos show it in perspective under
  studio lighting, so a vector redraw stays sharp at any width. Onion domes
  with finials and balconied minarets are what make it read as Indian rather
  than as a generic skyline.

  Arches are subpaths inside each building's own `d` so fill-rule="evenodd"
  cuts them out. As separate <path> elements they would paint over the
  building in the same colour and vanish.

  `opacity` is a prop, not a class: Astro scopes styles to a component's own
  elements, so a parent styling `.hero__city` never reaches this SVG.

  Purely decorative: aria-hidden, carries no information.
*/
interface Props {
  color?: string;
  opacity?: number;
  class?: string;
}
const { color = 'currentColor', opacity = 1, class: className = '' } = Astro.props;
---

<svg
  class={`cityscape ${className}`}
  viewBox="0 0 1240 112"
  preserveAspectRatio="xMidYMax meet"
  role="presentation"
  aria-hidden="true"
  focusable="false"
  style={`--city-color:${color};--city-opacity:${opacity}`}
>
  <g fill="var(--city-color)" fill-rule="evenodd">
    <path d="M63,112 v-58 h10 v58 Z M56,54 h24 v-3 h-24 Z M60,50 C60,40 60,35 65,32 C67,32 69,32 71,32 C76,35 76,40 76,50 Z M66,31 h4 l-1,-5 h-2 Z M67,26 h2 l-1,-7 Z"/>
    <path d="M108,112 v-54 h124 v54 Z M115,112 v-16 Q115,80 124,80 Q132,80 132,96 v16 Z M146,112 v-16 Q146,80 154,80 Q163,80 163,96 v16 Z M177,112 v-16 Q177,80 186,80 Q194,80 194,96 v16 Z M208,112 v-16 Q208,80 216,80 Q225,80 225,96 v16 Z"/>
    <path d="M251,112 v-48 h98 v48 Z M252,64 C252,34 256,21 284,14 C293,12 307,12 316,14 C344,21 348,34 348,64 Z M298,10 h4 l-1,-8 h-2 Z M299,2 h2 l-1,-10 Z"/>
    <path d="M244,112 v-43 h7 v43 Z M239,69 h18 v-3 h-18 Z M242,66 C242,58 242,55 246,53 C247,52 249,52 250,53 C254,55 254,58 254,66 Z M246,52 h4 l-1,-4 h-2 Z M247,48 h2 l-1,-5 Z"/>
