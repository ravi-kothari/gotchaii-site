    <path d="M400,112 v-44 h110 v44 Z M409,112 v-13 Q409,86 418,86 Q428,86 428,99 v13 Z M445,112 v-13 Q445,86 455,86 Q465,86 465,99 v13 Z M482,112 v-13 Q482,86 492,86 Q501,86 501,99 v13 Z"/>
    <path d="M564,112 v-38 h72 v38 Z M565,74 C565,51 568,40 588,35 C595,33 605,33 612,35 C632,40 635,51 635,74 Z M598,32 h4 l-1,-6 h-2 Z M599,26 h2 l-1,-8 Z"/>
    <path d="M664,112 v-48 h132 v48 Z M672,112 v-14 Q672,83 680,83 Q689,83 689,98 v14 Z M705,112 v-14 Q705,83 714,83 Q722,83 722,98 v14 Z M738,112 v-14 Q738,83 746,83 Q755,83 755,98 v14 Z M771,112 v-14 Q771,83 780,83 Q788,83 788,98 v14 Z"/>
    <path d="M818,112 v-51 h8 v51 Z M812,61 h20 v-3 h-20 Z M815,58 C815,49 816,45 820,43 C821,42 823,42 824,43 C828,45 829,49 829,58 Z M820,41 h4 l-1,-5 h-2 Z M821,37 h2 l-1,-6 Z"/>
    <path d="M861,112 v-42 h82 v42 Z M862,70 C862,45 865,33 888,27 C896,25 908,25 916,27 C939,33 942,45 942,70 Z M900,24 h4 l-1,-7 h-2 Z M901,17 h2 l-1,-9 Z"/>
    <path d="M962,112 v-40 h114 v40 Z M971,112 v-12 Q971,88 981,88 Q991,88 991,100 v12 Z M1009,112 v-12 Q1009,88 1019,88 Q1029,88 1029,100 v12 Z M1047,112 v-12 Q1047,88 1057,88 Q1067,88 1067,100 v12 Z"/>
    <path d="M1104,112 v-55 h9 v55 Z M1097,57 h22 v-3 h-22 Z M1100,54 C1100,44 1101,40 1105,38 C1107,37 1109,37 1111,38 C1115,40 1116,44 1116,54 Z M1106,36 h4 l-1,-5 h-2 Z M1107,31 h2 l-1,-6 Z"/>
    <path d="M1148,112 v-34 h92 v34 Z M1159,112 v-10 Q1159,92 1171,92 Q1183,92 1183,102 v10 Z M1205,112 v-10 Q1205,92 1217,92 Q1229,92 1229,102 v10 Z"/>
  </g>
</svg>

<style>
  .cityscape {
    display: block;
    width: 100%;
    height: auto;
    color: var(--city-color);
    opacity: var(--city-opacity);
  }
</style>
