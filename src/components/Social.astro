---
/*
  Icon links to the brand's social profiles. Icons are inline SVG rather than an
  icon font or sprite sheet: two glyphs is not worth an extra request, and
  inline paths inherit currentColor so they work on both the ink footer and any
  light surface.

  Each link carries a visible-to-screen-reader label; the glyph alone is not an
  accessible name.
*/
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const profiles = [
  { name: 'Instagram', href: 'https://instagram.com/gotchaii' },
  { name: 'TikTok', href: 'https://tiktok.com/@gotchaii' },
];
---

<ul class={`social ${className}`} role="list">
  {
    profiles.map((p) => (
      <li>
        <a
          class="social__link"
          href={p.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Got Chaii on ${p.name}`}
        >
          {p.name === 'Instagram' ? (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" fill="none" stroke="currentColor" stroke-width="1.8" />
              <circle cx="12" cy="12" r="4.4" fill="none" stroke="currentColor" stroke-width="1.8" />
              <circle cx="17.6" cy="6.4" r="1.3" fill="currentColor" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M15.6 2.5h2.6a5.9 5.9 0 0 0 3.3 4.2v2.7a8.5 8.5 0 0 1-3.9-1.2v6.4a6.1 6.1 0 1 1-5.3-6v2.8a3.3 3.3 0 1 0 2.4 3.2Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"
              />
            </svg>
          )}
          <span class="social__name">{p.name}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    gap: var(--space-s);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 2px solid currentColor;
    border-radius: var(--radius-pill);
    color: inherit;
    transition: color 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }

  .social__link:hover {
    color: var(--foam);
    transform: translateY(-2px);
  }

  .social__link svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  /* Visually hidden, still announced. */
  .social__name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
