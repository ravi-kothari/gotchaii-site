---
import { Image } from 'astro:assets';
import cafeDrinks from '../assets/cafe-drinks.png';

/*
  The drinks poured at the stall. These are NOT shippable products — they are a
  menu, so there are no prices-as-buttons and no cart affordances. The spec is
  explicit that a cup of chaii must never look orderable online.

  Numbered 01/02/03 deliberately: the printed market menu is an ordered list and
  people point at numbers when ordering at a stall, so the numbering carries
  real information rather than decorating.
*/
const pours = [
  { n: '01', name: 'Mango Masala', notes: 'mango · spiced chaii · whole milk' },
  { n: '02', name: 'Mystic Blue', notes: 'butterfly pea · citrus · over ice' },
  { n: '03', name: 'Masala Cold Foam', notes: 'masala chaii · rose · salted foam' },
];
const base = import.meta.env.BASE_URL;
const menuHref = `${base.replace(/\/$/, '')}/menu`;
---

<section class="cafe section section--cream" id="cafe">
  <div class="wrap cafe__inner">
    <figure class="cafe__figure">
      <Image
        src={cafeDrinks}
        alt="Three iced chaii drinks side by side on terracotta: layered mango, vivid blue citrus, and rose-topped cold foam."
        widths={[480, 768, 1100]}
        sizes="(max-width: 900px) 92vw, 48vw"
        loading="lazy"
        class="cafe__img"
      />
    </figure>

    <div class="cafe__copy">
      <p class="cafe__eyebrow">At the chaii bar</p>
      <h2 class="cafe__title">Tradition, with a twist.</h2>
      <p class="cafe__lede">
        We start with real tea and whole spices, then play with fruit, botanicals
        and silky textures. Poured fresh at the market — not shipped.
      </p>

      <ol class="pours" role="list">
        {
          pours.map((p) => (
            <li class="pour">
              <span class="pour__n" aria-hidden="true">
                {p.n}
              </span>
              <span class="pour__text">
                <span class="pour__name">{p.name}</span>
                <span class="pour__notes">{p.notes}</span>
              </span>
            </li>
          ))
        }
      </ol>

      <a class="cafe__link" href={menuHref}>See the full menu</a>
    </div>
  </div>
</section>

<style>
  .cafe__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .cafe__inner > * {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .cafe__inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cafe__figure {
    margin: 0;
  }

  .cafe__img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
    border: 3px solid var(--ink);
  }

  .cafe__eyebrow {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--burnt-orange-text);
    margin-block-end: var(--space-xs);
  }

  .cafe__title {
    font-size: var(--step-4);
    margin-block-end: var(--space-s);
  }

  .cafe__lede {
    font-size: var(--step-1);
    max-width: 42ch;
    margin-block-end: var(--space-l);
  }

  .pours {
    list-style: none;
    margin: 0 0 var(--space-l);
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .pour {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    padding-block: 0.85rem;
    border-block-start: 1.5px dashed rgba(30, 26, 23, 0.28);
  }

  .pour:last-child {
    border-block-end: 1.5px dashed rgba(30, 26, 23, 0.28);
  }

  .pour__n {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--indigo);
    line-height: 1;
    flex-shrink: 0;
  }

  .pour__text {
    display: flex;
    flex-direction: column;
  }

  .pour__name {
    font-size: var(--step-1);
    font-weight: 700;
  }

  .pour__notes {
    font-family: var(--font-accent);
    color: var(--amber-text);
  }

  .cafe__link {
    display: inline-block;
    font-weight: 700;
    color: var(--indigo);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }
</style>
